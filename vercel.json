{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "outputDirectory": ".next",
  "crons": [
    {
      "path": "/api/cron/appointment-reminders",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/purge-video-signals",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/ingest",
      "schedule": "0 */6 * * *"
    },
    {
      "path": "/api/cron/ingest-providers",
      "schedule": "15 */6 * * *"
    },
    {
      "path": "/api/cron/purge-held-applications",
      "schedule": "23 6 * * *"
    }
  ]
}
