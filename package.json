{
  "name": "pawline",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "mcp"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "db:migrate": "node scripts/migrate.mjs",
    "db:migrate:dry-run": "node scripts/migrate.mjs --dry-run",
    "db:migrate:appointments": "node scripts/migrate-appointments.mjs",
    "start": "next start",
    "test:chat": "playwright test --config playwright.chat.config.js",
    "test:appointments": "playwright test --config playwright.appointments.config.js",
    "test:app": "playwright test --config playwright.app.config.js",
    "test": "node --test && python -m unittest discover -s test -p \"test_*.py\""
  },
  "dependencies": {
    "@clerk/backend": "^3.26.6",
    "@clerk/nextjs": "^7.9.24",
    "@clerk/react": "^6.18.5",
    "@daily-co/daily-js": "^0.92.2",
    "@neondatabase/serverless": "^1.2.0",
    "ably": "^2.30.0",
    "ai": "^7.0.162",
    "lucide-react": "^1.68.0",
    "mapbox-gl": "^3.34.2",
    "next": "^16.4.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.4",
    "autoprefixer": "^10.6.2",
    "axe-core": "^4.14.0",
    "esbuild": "^0.28.2",
    "jsdom": "^31.0.0",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.4"
  },
  "overrides": {
    "postcss": "$postcss",
    "sharp": "^0.35.0"
  }
}
