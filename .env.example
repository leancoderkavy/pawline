# Server-only secrets. Do not prefix these with VITE_.
DATABASE_URL=
AI_GATEWAY_API_KEY=
CRON_SECRET=
SEO_PIPELINE_SECRET=
TAVILY_API_KEY=
RESCUEGROUPS_API_KEY=
MAPBOX_ACCESS_TOKEN=
# Nearby animal-shelter locations use a bounded, cached OpenStreetMap Overpass query by default.
# Set this to a managed or self-hosted endpoint before high-volume production use.
OVERPASS_API_BASE_URL=https://overpass-api.de/api/interpreter
RESEND_API_KEY=
AI_GATEWAY_API_KEY=
PAWLINE_AI_MODEL=google/gemini-2.5-flash-lite
PAWLINE_SEO_MODEL=google/gemini-2.5-flash-lite
# Private shelter-source review workflow. Keep both enable flags false or unset
# until the database migration, reviewed operator process, and cost limits are ready.
SHELTER_OUTREACH_SECRET=
SHELTER_OUTREACH_MODEL=google/gemini-2.5-flash-lite
SHELTER_OUTREACH_MONTHLY_MAX_GENERATIONS=10
SHELTER_OUTREACH_DAILY_EMAIL_LIMIT=20
SHELTER_OUTREACH_AI_ENABLED=false
SHELTER_OUTREACH_SEND_ENABLED=false
CLERK_SECRET_KEY=
CLERK_AUTHORIZED_PARTIES=http://localhost:3000,http://localhost:4173,http://127.0.0.1:4173,https://www.pawlineadopt.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
ABLY_API_KEY=
# Private video: configure a coturn-compatible TURN relay before enabling.
# The shared secret stays server-side; call participants receive expiring credentials.
PAWLINE_VIDEO_ENABLED=false
PAWLINE_TURN_URLS=
PAWLINE_TURN_SHARED_SECRET=
# Local development only; ignored when NODE_ENV=production.
PAWLINE_VIDEO_ALLOW_DIRECT=false

# Resend requires a sender on a verified domain for production recipients.
PAWLINE_FROM_EMAIL=Pawline <adoptions@example.com>
PAWLINE_MODERATION_EMAIL=

# Canonical organization claims and verified Resend delivery events.
PAWLINE_CANONICAL_ORIGIN=https://www.pawlineadopt.com
RESEND_WEBHOOK_SECRET=

# Optional private OpenRouter helpers. These values are server-only. Keep
# calls disabled until reviewed ZDR-capable routes and task evaluations exist.
OPENROUTER_API_KEY=
OPENROUTER_ENABLED=false
OPENROUTER_LIVE_CALLS_ENABLED=false
OPENROUTER_ZDR=true
OPENROUTER_DATA_COLLECTION=deny
OPENROUTER_ALLOWED_MODELS=
OPENROUTER_ALLOWED_PROVIDERS=
OPENROUTER_APPLICATION_COACH_MODEL=
OPENROUTER_INTAKE_SUMMARIZER_MODEL=
